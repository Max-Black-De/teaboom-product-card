{
  "name": "teaboom-product-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sass --watch --no-source-map src/styles/main.scss:css/main.css & vite",
    "build": "npm run build:css && node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "build:css": "sass --no-source-map src/styles/main.scss css/main.css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.4"
  }
}
